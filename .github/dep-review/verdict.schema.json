{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dep-review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "consumer_note",
    "changes",
    "holds_add",
    "holds_remove"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "consumer_note": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "decision",
          "risk",
          "release_impact",
          "reason",
          "evidence"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "accept",
              "hold",
              "reject"
            ]
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "release_impact": {
            "enum": [
              "none",
              "patch",
              "minor",
              "major"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "holds_add": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "reason"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "holds_remove": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "reason"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
