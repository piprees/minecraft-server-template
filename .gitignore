.env
.stack/
modpack-dist/

# === Secrets - never commit ===
.env
*.env.local
config/server.local.env

# === Server data - large, generated, personal ===
# Root-anchored: mod jars carry their datapacks in src/main/resources/data/,
# which an unanchored data/ silently swallowed.
/data/
!config/datapacks/**/data/
backups/

# === Backup copies made by scripts ===
*.bak.*

# === Cloudflare tunnel credentials ===
config/cloudflared/*.json
config/cloudflared/cert.pem

# === Restic ===
restic-password.txt

# === Logs ===
logs/
*.log
*.lock

# === Seed-rolling artefacts ===
/.seed-rolling/

__pycache__
*/__pycache__/*

# === Built modpack files ===
modpack/*.mrpack
modpack/dist/

# === Stack bundle build output ===
dist/

# === Asset cache (Docker images, mod JARs, offline bundles) ===
cache/
mods-cache/

# === In-house mod build artifacts ===
mods/*/build/
mods/*/.gradle/
mods/*/run/
mods/*/.fabric/

# === Built mod JARs (produced by CI, never committed) ===
dist/local-mods/

# === Mod development scratch ===
scratch/

# === OS / editor junk ===
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# === Docker override (local dev only, created by --offline mode) ===
docker-compose.override.yml

# === Claude Code / AI agent state ===
.github/.hooks-state/
.claude/*
!.claude/skills/
.claude/skills/.github/
docker-compose.modrinth.yml
config/nginx/nav-proxy-local.conf

# === Setup wizard state ===
.setup-state/

pivot/
__pycache__/

# generated jar download cache (gen-structure-presets.py)
/.cache/
.seedtest/

# Serena semantic-code-intelligence cache
.serena/

# === Impeccable cache ===
.impeccable

# ~100MB binary that produces it is not.

# Session handoff notes (local scratch, not repo documentation)
.handoff/

# Eclipse/IDE build output under the mod projects
mods/*/bin/
