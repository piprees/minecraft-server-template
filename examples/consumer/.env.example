# Your server. Copy to .env and fill in the blanks — or run ./ops setup,
# which walks you through creating every credential and writes this file.
#
# Conventions:
#   VAR=            you must fill this in
#   # VAR=          optional — uncomment to override the platform default
#   # e.g. VAR='…'  what a real value looks like
#
# Platform defaults (MC version, memory, ports, …) live in the stack bundle;
# a lean .env with only these lines is a complete config.
# Which token/key is which: see docs/credentials.md in the template repo.

# === Identity (make it yours) ===
# e.g. BRAND_NAME='Elfydd'
BRAND_NAME=
# Lowercase, no spaces. e.g. BRAND_SLUG=elfydd
BRAND_SLUG=
# Your Cloudflare-managed domain. e.g. DOMAIN=example.com
DOMAIN=
# Local-dev subdomains. Default: <BRAND_SLUG>.local
# LOCAL_DOMAIN=
# Blank = random world seed for level.dat. Legacy fallback — only reaches
# terrain when a dimension config's "seed" field is literally "env"; set the
# real seed in config/custom-dimensions/dimensions/overworld.json (or the
# overlay) instead (TROUBLESHOOTING.md#t31 in the template repo).
# e.g. SEED=-4530634556500121041
SEED=
# Legacy fallback for where players spawn — deploy.sh only applies these when
# the overworld's dimension config has no spawn chosen. Set spawn in
# config/custom-dimensions/dimensions/overworld.json (or the overlay)
# instead; an in-game /setworldspawn doesn't stick either way.
SPAWN_X=
SPAWN_Y=
SPAWN_Z=

# Stack (template) release your server runs. A major pin like v5 floats on
# the latest v5.x.y release, so updates arrive with ./dev update / deploys.
# Pin exactly (STACK_VERSION=v5.27.0) for reproducible deploys; bump majors
# deliberately.
STACK_VERSION=v5

# === Discord ===
# Role IDs: enable Developer Mode, right-click role > Copy ID.
# e.g. DISCORD_ADMIN_ROLE_ID=000000000000000000
DISCORD_ADMIN_ROLE_ID=
DISCORD_PLAYER_ROLE_ID=
# e.g. DISCORD_INVITE_URL='https://discord.gg/xxxxxxx'
DISCORD_INVITE_URL=
# Public URL for the brand icon. Shown as the Discord webhook avatar.
# Grab from the Developer Portal (app > General > icon URL).
# BRAND_ICON_URL=
# Bot token: discord.com/developers > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=
# Admin/ops channel: bot output, mod updates, CI + status notifications
DISCORD_CHANNEL_ID=
# Optional: separate channel for the in-game chat <-> Discord sync.
# Unset = game chat syncs to DISCORD_CHANNEL_ID like before.
DISCORD_CHAT_CHANNEL_ID=
DISCORD_GUILD_ID=
# Channel > Integrations > Webhooks
# e.g. DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/…'
DISCORD_WEBHOOK_URL=

# === Infrastructure (provisioned by ./ops setup) ===
# "hetzner" (default assumed by ./ops provision), "digitalocean", or "local"
# CLOUD_PROVIDER=hetzner

# Hetzner API token: console.hetzner.cloud > project > Security > API tokens,
# Read & Write. 64 alphanumeric chars.
HCLOUD_TOKEN=

# Cloudflare API token. Create at dash.cloudflare.com > My Profile >
# API Tokens > Create Custom Token with Account/Cloudflare Tunnel:Edit,
# Account/Workers R2 Storage:Edit, Account/Workers Scripts:Edit,
# Zone/DNS:Edit, Zone/Zone:Read. 40+ chars, newer tokens start with cfut_.
# This is the custom API token, not the Global API Key and not the token
# from the R2 page.
CLOUDFLARE_API_TOKEN=
# Both 32 hex chars, from any zone's Overview page (right column).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# R2 S3 keypair for backups, a separate credential from the API token above.
# Create at R2 > Manage API Tokens > Create Account API token > Object Read
# & Write. Copy the Access Key ID (32 hex) and Secret Access Key (64 hex).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Same value as CLOUDFLARE_ACCOUNT_ID.
R2_ACCOUNT_ID=
# e.g. R2_BUCKET=myserver-backups
R2_BUCKET=

# Backup encryption passphrase. Cannot be recovered if lost, so keep it safe.
# e.g. RESTIC_PASSWORD="$(openssl rand -base64 24)"
RESTIC_PASSWORD=
# Auto-generated by ./dev up when blank.
RCON_PASSWORD=
KUMA_PASSWORD=

# The seed viewer the mod hosts (./dev seeds). Local dev only — published on
# 127.0.0.1 by the local compose override and by nothing in production.
# SEED_VIEWER_PORT=8765

# Log level for the in-house custom-dimensions mod (info | debug).
# "debug" turns on the immersive-portal diagnostics -- projection and
# sightline-mask counts, deferred-packet counts, aura passes. Those counts are
# the primary evidence for this feature, whose defects are silent absence
# rather than crashes. Verbose; leave at info unless investigating.
# Restart the mc container to apply.
CUSTOMDIM_LOG_LEVEL='info'
