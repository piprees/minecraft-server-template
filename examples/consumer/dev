#!/usr/bin/env bash
# dev — Local development entrypoint.
# Thin wrapper that resolves paths/env and delegates to bundle scripts.
# Contains NO stack logic.
set -euo pipefail

CONSUMER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$CONSUMER_DIR"

STACK_SCRIPTS=".stack/current/stack/scripts"

# Scaffold files are copies of the bundle's, refreshed by `./dev update`, and
# nothing prompts that — a consumer can sit for releases without `link`,
# `unlink` or `reset-world`, the only symptom being the command printing
# usage. The file itself is the version: differing from the bundled copy IS
# being out of date, so there is no number to bump and no way for two entry
# points to disagree about what a number means.
check_scaffold_version() {
  local bundled="$CONSUMER_DIR/.stack/current/stack/examples/consumer/dev"
  [[ -f "$bundled" ]] || return 0
  cmp -s "$bundled" "$CONSUMER_DIR/dev" && return 0
  echo "NOTE: ./dev differs from the copy this stack ships — run" \
    "'./dev update' to refresh the entry points." >&2
}

usage() {
  echo "Usage: ./dev <command>"
  echo ""
  echo "Commands:"
  echo "  up       Start the local dev stack"
  echo "  down     Stop the local dev stack"
  echo "  logs     Tail the Minecraft server logs"
  echo "  rcon     Run an RCON command (e.g. ./dev rcon \"list\")"
  echo "  seeds    Open the seed viewer — roll, look, try a candidate out, pick one"
  echo "  run      Local dev runner: rebuild, install, restart, launch, tail"
  echo "           (--no-tail to return instead of following the client log)"
  echo "  launch   Start the Minecraft client against this local server"
  echo "  client-log  Snapshot the client's log ([--tail N] [--grep PATTERN])"
  echo "  logs-all    Server + client in one time-ordered view (UTC normalised)"
  echo "  screenshot  Capture the running client window ([--out PATH] [--delay N] [--full] [--no-focus])"
  echo "  input       Drive the client: key/hold/type/chat/click/focus (./dev input for help)"
  echo "  reload   Rebuild the linked checkout's in-house mods and re-stage them"
  echo "  pack     Build the client modpack into ./modpack-dist/"
  echo "  pin      Re-pin overlay/mods-extra.txt to latest mod builds (review with git diff)"
  echo "  pull     Fetch the stack bundle only (first boot / cache recovery)"
  echo "  update   Pull the latest stack bundle + Docker images"
  echo "  refresh-config Force-refresh platform config defaults (backs up data/config; overlay wins)"
  echo "  clean    Delete regenerable state by target (./dev clean --list)."
  echo "           Default: stack pack cache mods config. --dry-run to preview"
  echo "  rollback Revert to a previous stack bundle version"
  echo "  verify      Show where dimension/portal verification lives now (mod tests + /customdim lint)"
  echo "  link     Point .stack/current at a platform checkout (default ../minecraft-server-template)"
  echo "  unlink   Restore the newest pulled release bundle"
  echo "  reset-world Delete the LOCAL world + player data (same set ./ops reset-seed deletes on production)"
  echo "  cache    Snapshot Docker images, mod JARs, offline client bundles"
  echo "  start    Start a stopped service (e.g. ./dev start uptime-kuma)"
  echo "  stop     Stop a running service (e.g. ./dev stop uptime-kuma)"
  echo "  restart  Force-recreate a service (e.g. ./dev restart nav-proxy)"
  echo "  status   Show container status (e.g. ./dev status)"
  echo "  doctor   Local health check (containers, RCON, seed exit)"
  echo ""
  echo "Production equivalents: ./ops help"
  echo "  dev up      ↔  (push to main triggers CI)"
  echo "  dev logs    ↔  ops logs [--tail N]"
  echo "  dev rcon    ↔  ops rcon"
  echo "  dev status  ↔  ops status"
}

ensure_env() {
  if [[ ! -f "$CONSUMER_DIR/.env" ]]; then
    echo "No .env found. Run ./ops setup first, or:"
    echo "  cp .env.example .env"
    echo "  # then fill in your secrets"
    exit 1
  fi
}

# Pull/refresh the stack bundle. The full-featured puller lives IN the
# bundle (scripts/stack-pull.sh) — safe to run from the bundle it updates,
# because each release unpacks into an immutable .stack/<version>/ dir and
# only the .stack/current symlink moves. bootstrap_stack below is the
# minimal first-ever pull for when no bundle exists yet.

# The pin the puller resolves comes from .env when the file carries one —
# a STACK_VERSION already exported into this shell (an earlier `set -a;
# source .env`, a wrapper, direnv) must never beat a fresh .env edit. The
# ambient variable only decides when .env has no pin. For a one-off pull of
# a different version, run the bundle's scripts/stack-pull.sh directly.
resolve_stack_pin() {
  local env_pin=""
  if [[ -f "$CONSUMER_DIR/.env" ]]; then
    env_pin=$(grep -E '^STACK_VERSION=' "$CONSUMER_DIR/.env" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'") || true
  fi
  if [[ -n "$env_pin" ]]; then
    if [[ -n "${STACK_VERSION:-}" && "$STACK_VERSION" != "$env_pin" ]]; then
      echo "NOTE: using STACK_VERSION=$env_pin from .env (ignoring exported STACK_VERSION=$STACK_VERSION)" >&2
    fi
    export STACK_VERSION="$env_pin"
  fi
}

# Resolve the Prism Launcher instance this consumer's pack was imported as.
# Newest match wins, because an import per pack build leaves several behind.
# Echoes the .minecraft directory; empty and non-zero when there is no match.
# The game JVM Prism starts. Both terms are required: the launcher process
# carries the instance id too, and matching it alone finds the launcher.
# A synthetic click with no preceding MOTION lands wherever the target last
# thought the pointer was, so AppleScript's "click at" does nothing in a game.
# CGWarpMouseCursorPosition plus a real event is the only thing that works.
# Compiled on demand and cached; the source lives here so `dev` stays one file.
ensure_mouse_helper() {
  local cache="$CONSUMER_DIR/.dev-cache"
  local bin="$cache/dev-mouse"
  local src="$cache/dev-mouse.swift"
  if [[ -x "$bin" && "$bin" -nt "$CONSUMER_DIR/dev" ]]; then
    echo "$bin"
    return 0
  fi
  if ! command -v swiftc >/dev/null 2>&1; then
    echo "swiftc not found — install the Xcode command line tools (xcode-select --install)." >&2
    return 1
  fi
  mkdir -p "$cache"
  cat > "$src" <<'SWIFTEOF'
import CoreGraphics
import Foundation

let a = CommandLine.arguments
guard a.count >= 4, let x = Double(a[2]), let y = Double(a[3]) else { exit(2) }
let p = CGPoint(x: x, y: y)

func post(_ t: CGEventType, _ clicks: Int64, _ button: CGMouseButton = .left) {
    guard let e = CGEvent(mouseEventSource: nil, mouseType: t,
                          mouseCursorPosition: p, mouseButton: button) else { return }
    e.setIntegerValueField(.mouseEventClickState, value: clicks)
    e.post(tap: .cghidEventTap)
}

CGWarpMouseCursorPosition(p)
post(.mouseMoved, 0)
usleep(150_000)

switch a[1] {
case "move": break
case "click":
    post(.leftMouseDown, 1); usleep(50_000); post(.leftMouseUp, 1)
case "dblclick":
    post(.leftMouseDown, 1); usleep(40_000); post(.leftMouseUp, 1); usleep(80_000)
    post(.leftMouseDown, 2); usleep(40_000); post(.leftMouseUp, 2)
case "rightclick":
    post(.rightMouseDown, 1, .right); usleep(60_000); post(.rightMouseUp, 1, .right)
default: exit(2)
}
SWIFTEOF
  if ! swiftc -O -o "$bin" "$src" 2>/dev/null; then
    echo "Could not compile the mouse helper." >&2
    return 1
  fi
  echo "$bin"
}

prism_client_pid() {
  local want="$1" candidate
  pgrep -f 'org.prismlauncher.EntryPoint' 2>/dev/null | while read -r candidate; do
    ps -ww -o command= -p "$candidate" 2>/dev/null | grep -qF "$want" && echo "$candidate"
  done | head -1
}

# docker -t stamps RFC3339 UTC; the client stamps local. Both are rewritten to
# one local HH:MM:SS so a live interleave reads in the order things happened.
stamp_server_stream() {
  python3 -u -c 'import sys,re
from datetime import datetime
for line in sys.stdin:
    m = re.match(r"(\S+)\s(.*)", line.rstrip("\n"))
    if not m:
        continue
    stamp, rest = m.groups()
    try:
        ts = datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone()
    except ValueError:
        continue
    print("%s SERVER | %s" % (ts.strftime("%H:%M:%S"), rest), flush=True)'
}

stamp_client_stream() {
  python3 -u -c 'import sys,re
for line in sys.stdin:
    text = line.rstrip("\n")
    m = re.match(r"\[(\d\d:\d\d:\d\d)\]\s?(.*)", text)
    if m:
        print("%s CLIENT | %s" % (m.group(1), m.group(2)), flush=True)
    else:
        print("         CLIENT | %s" % text, flush=True)'
}

resolve_client_instance() {
  local root="$HOME/Library/Application Support/PrismLauncher/instances"
  [[ -d "$root" ]] || return 1
  local want="${1:-${BRAND_SLUG:-}}"
  local d newest="" game=""
  # Newest wins: an import per pack build leaves several behind. Globbed
  # rather than parsing ls, and compared with -nt, which bash 3.2 has.
  for d in "$root"/*; do
    [[ -d "$d" ]] || continue
    [[ -n "$want" && "$(basename "$d")" != *"$want"* ]] && continue
    if [[ -d "$d/minecraft" ]]; then
      game="$d/minecraft"
    elif [[ -d "$d/.minecraft" ]]; then
      game="$d/.minecraft"
    else
      continue
    fi
    if [[ -z "$newest" || "$d" -nt "$newest" ]]; then
      newest="$d"
      RESOLVED_GAME_DIR="$game"
    fi
  done
  [[ -n "$newest" ]] || return 1
  echo "$RESOLVED_GAME_DIR"
}

stack_pull() {
  resolve_stack_pin
  if [[ -f "$CONSUMER_DIR/$STACK_SCRIPTS/stack-pull.sh" ]]; then
    (cd "$CONSUMER_DIR" && bash "$CONSUMER_DIR/$STACK_SCRIPTS/stack-pull.sh")
  else
    bootstrap_stack
  fi
}

bootstrap_stack() {
  local repo="piprees/minecraft-server-template"
  local pin=""
  if [[ -f "$CONSUMER_DIR/.env" ]]; then
    pin=$(grep -E '^STACK_VERSION=' "$CONSUMER_DIR/.env" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'") || true
  fi
  pin="${pin:-${STACK_VERSION:-}}"
  pin="${pin:-latest}"
  pin="${pin#v}"
  [[ "$pin" == "latest" ]] && pin=""
  echo "Bootstrapping stack bundle (pin: ${pin:-latest})..."

  local releases="" tag=""
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    releases=$(curl -fsSL --connect-timeout 10 --max-time 30 \
      -H "Authorization: Bearer ${GITHUB_TOKEN}" \
      "https://api.github.com/repos/$repo/releases" 2> /dev/null) || true
  fi
  if [[ -z "$releases" ]] && command -v gh > /dev/null 2>&1 && gh auth status > /dev/null 2>&1; then
    releases=$(gh api "/repos/$repo/releases" 2> /dev/null) || true
  fi
  if [[ -z "$releases" ]]; then
    releases=$(curl -fsSL --connect-timeout 10 --max-time 30 \
      "https://api.github.com/repos/$repo/releases" 2> /dev/null) || true
  fi
  tag=$(echo "$releases" \
    | grep -oE '"tag_name"\s*:\s*"v[0-9]+\.[0-9]+\.[0-9]+"' \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' \
    | sort -t. -k1,1nr -k2,2nr -k3,3nr \
    | while IFS= read -r t; do
        if [[ -z "$pin" || "$t" == "$pin" || "$t" == "$pin".* ]]; then
          echo "v$t"
          break
        fi
      done)
  if [[ -z "$tag" ]]; then
    echo "ERROR: could not resolve a release matching '${pin:-latest}'" >&2
    exit 1
  fi

  local bare="${tag#v}"
  local dir="$CONSUMER_DIR/.stack/$tag"
  local tarball="stack-v${bare}.tar.gz"
  echo "Downloading $tag..."
  mkdir -p "$dir"
  local f
  for f in "$tarball" "$tarball.sha256"; do
    curl -fSL --connect-timeout 10 --max-time 120 -o "$dir/$f" \
      "https://github.com/$repo/releases/download/$tag/$f"
  done
  if ! (cd "$dir" && { shasum -a 256 -c "$tarball.sha256" > /dev/null 2>&1 || sha256sum -c "$tarball.sha256" > /dev/null 2>&1; }); then
    echo "ERROR: checksum verification failed — removing corrupted download" >&2
    rm -rf "$dir"
    exit 1
  fi
  tar -xzf "$dir/$tarball" -C "$dir"
  ln -sfn "$tag" "$CONSUMER_DIR/.stack/current"
  echo "$tag ready at .stack/current"
}

ensure_stack() {
  if [[ ! -d "$CONSUMER_DIR/.stack/current" ]]; then
    echo "Stack bundle not found. Pulling..."
    stack_pull
  fi
}

ensure_docker() {
  if docker info &> /dev/null; then
    return
  fi
  echo "Docker is not running. Starting..."
  if [[ "$(uname)" == "Darwin" ]]; then
    open -a Docker
  else
    systemctl start docker 2> /dev/null || sudo systemctl start docker
  fi
  local tries=0
  while ! docker info &> /dev/null && [[ $tries -lt 30 ]]; do
    sleep 2
    tries=$((tries + 1))
  done
  if ! docker info &> /dev/null; then
    echo "Docker failed to start after 60s."
    exit 1
  fi
  echo "Docker started."
}

# Change-detection checksum of this script. cksum is POSIX, so it behaves
# identically on macOS and Linux (md5/md5sum don't share a name or format).
self_sum() {
  cksum "$CONSUMER_DIR/dev" 2> /dev/null | awk '{print $1"-"$2}'
}

# If an update just replaced this script on disk, re-exec the same command
# so the rest of the run (and everything after it) uses the new code - the
# in-memory copy of a self-updated script is stale by definition.
# DEV_SELF_REEXEC guards against loops; a second pass sees equal sums anyway.
reexec_if_self_updated() {
  local before="$1"
  shift
  if [[ "$(self_sum)" != "$before" && -z "${DEV_SELF_REEXEC:-}" ]]; then
    echo "==> dev script was updated - re-running '$1' with the new version..."
    DEV_SELF_REEXEC=1 exec bash "$CONSUMER_DIR/dev" "$@"
  fi
}

CMD="${1:-help}"
shift || true

# Show the deploy banner (if available) for a branded feel on every command.
if [[ "$CMD" != "help" && "$CMD" != "--help" && "$CMD" != "-h" ]]; then
  _banner="$CONSUMER_DIR/overlay/config/deploy-banner.txt"
  [[ -f "$_banner" ]] || _banner="$CONSUMER_DIR/.stack/current/stack/config/deploy-banner.txt"
  if [[ -f "$_banner" ]]; then
    printf '\033[1m'
    cat "$_banner"
    printf '\033[0m'
  fi
  _brand=""
  [[ -f "$CONSUMER_DIR/.env" ]] && _brand=$(grep -E '^BRAND_NAME=' "$CONSUMER_DIR/.env" | head -1 | cut -d= -f2- | tr -d "'" | tr -d '"') || true
  echo "  ${_brand:+$_brand — }dev $CMD"
  echo ""
  export BANNER_SHOWN=1
  check_scaffold_version
  unset _banner _brand
fi

case "$CMD" in
  up)
    ensure_env
    ensure_stack
    ensure_docker
    if [[ "$(readlink "$CONSUMER_DIR/.stack/current" 2> /dev/null)" == "dev" ]]; then
      echo "=================================================================="
      echo "  LINKED TO PLATFORM CHECKOUT — .stack/current -> dev symlink farm"
      echo "  Configs, scripts and local-mods come from the checkout, not a"
      echo "  release. Restore the release bundle with: ./dev unlink"
      echo "=================================================================="
      echo ""
    fi
    export CONSUMER_DIR
    exec bash "$CONSUMER_DIR/$STACK_SCRIPTS/dev-up.sh" up
    ;;
  link)
    # Point .stack/current at a symlink farm over a platform checkout, so a
    # config/script/compose edit there is live here on the next roll or
    # ./dev up — no release needed. local-mods/ symlinks the checkout's BUILT
    # jars, so ./dev up installs local builds instead of reverting them.
    # Run once per consumer: every entry is a symlink, so a rebuild needs no
    # re-link.
    PLATFORM_ARG="${1:-$CONSUMER_DIR/../minecraft-server-template}"
    PLATFORM="$(cd "$PLATFORM_ARG" 2> /dev/null && pwd)" || {
      echo "ERROR: platform checkout not found: $PLATFORM_ARG"
      exit 1
    }
    if [[ ! -f "$PLATFORM/docker-compose.yml" || ! -d "$PLATFORM/scripts" ]]; then
      echo "ERROR: $PLATFORM does not look like a platform checkout"
      echo "       (needs docker-compose.yml and scripts/)"
      exit 1
    fi
    FARM="$CONSUMER_DIR/.stack/dev/stack"
    mkdir -p "$FARM"
    ln -sfn "$PLATFORM/config" "$FARM/config"
    ln -sfn "$PLATFORM/scripts" "$FARM/scripts"
    ln -sfn "$PLATFORM/examples" "$FARM/examples"
    ln -sfn "$PLATFORM/.env.example" "$FARM/.env.example"
    ln -sfn "$PLATFORM/docker-compose.yml" "$FARM/docker-compose.yml"
    ln -sfn "$PLATFORM/docker-compose.local.yml" "$FARM/docker-compose.local.yml"
    rm -rf "$FARM/local-mods" "$FARM/client-mods"
    mkdir -p "$FARM/local-mods" "$FARM/client-mods"
    JAR_COUNT=0
    CLIENT_JAR_COUNT=0
    for j in "$PLATFORM"/mods/*/build/libs/*.jar; do
      [[ -f "$j" ]] || continue
      case "$j" in *-dev.jar | *-sources.jar) continue ;; esac
      # grep without -q: -q exits at first match and the resulting SIGPIPE
      # into unzip reads as a pipeline failure under pipefail.
      if ! unzip -l "$j" 2> /dev/null | grep "refmap" > /dev/null; then
        echo "  WARNING: $(basename "$j") has no refmap — dev/unremapped jar skipped"
        continue
      fi
      # Route by the jar's own declared environment, not its name: a client mod
      # installed onto the server is refused at best and a boot break at worst.
      if unzip -p "$j" fabric.mod.json 2> /dev/null |
        tr -d ' \n' | grep '"environment":"client"' > /dev/null; then
        # Copied, not symlinked: the pack build mounts this directory into a
        # container, where a symlink to the checkout resolves to nothing.
        # ./dev pack re-copies, so a rebuild still propagates.
        cp -f "$j" "$FARM/client-mods/$(basename "$j")"
        CLIENT_JAR_COUNT=$((CLIENT_JAR_COUNT + 1))
        continue
      fi
      # Symlinked like the rest of the farm, so a rebuild needs no re-link.
      ln -sfn "$j" "$FARM/local-mods/$(basename "$j")"
      JAR_COUNT=$((JAR_COUNT + 1))
    done
    echo "dev" > "$FARM/VERSION"
    echo "$PLATFORM" > "$FARM/PLATFORM"
    ln -sfn dev "$CONSUMER_DIR/.stack/current"
    echo "=================================================================="
    echo "  LINKED TO PLATFORM CHECKOUT"
    echo "  .stack/current -> .stack/dev/stack -> $PLATFORM"
    echo "  local-mods:  $JAR_COUNT server jar(s) from the checkout"
    echo "  client-mods: $CLIENT_JAR_COUNT client jar(s) (pack only, never data/mods)"
    echo "  Local only — deploy paths refuse a 'dev' link. Restore with:"
    echo "  ./dev unlink"
    echo "=================================================================="
    ;;
  reset-world)
    # Local sibling of ./ops reset-seed: stops the stack and deletes the
    # SAME set production deletes. data/world/ carries the terrain, player
    # data, POI and level.dat for every dimension. Two SQLite stores do NOT
    # live there: locally they sit on the ledger-db and dh-db volumes, off
    # the virtiofs mount ([P5]), reached by symlink. Deleting only the
    # directory would leave the previous world's LOD cache and ledger to be
    # inherited by the next one, so the volumes go too. Also deletes map renders, Chunky state,
    # dynamic-data-pack-cache, and the portal/fingerprint state files that
    # describe the destroyed world. (deploy.sh-only in production, so
    # nothing to delete here): the per-dimension deploy-setup markers.
    # data/config/custom-dimensions goes too: it is seeded skip-if-exists,
    # so keeping it regenerates the new world from the OLD seeds and spawn
    # (D4), which reads as a passing test of a change that never applied.
    # Keeps .env, mods, the rest of data/config, overlay/ and the seed
    # bank. Change SEED in .env before ./dev up if a new seed is wanted.
    ensure_env
    ensure_stack
    echo "This deletes the LOCAL world and player data under $CONSUMER_DIR/data."
    echo "Kept: .env, data/mods, data/config (aside from custom-dimensions/,"
    echo "portal_links.json, custom-dimensions-fingerprints.json), overlay/,"
    echo ".seed-rolling/."
    if [[ "${1:-}" != "--force" ]]; then
      read -rp "Type RESET to confirm: " CONFIRM
      if [[ "$CONFIRM" != "RESET" ]]; then
        echo "Confirmation not received. Aborting."
        exit 1
      fi
    fi
    ensure_docker
    export CONSUMER_DIR
    bash "$CONSUMER_DIR/$STACK_SCRIPTS/dev-up.sh" down || true
    # The stack is down, so nothing holds these open. ensure_env only checks
    # .env exists, it does not source it, so BRAND_SLUG is read here — a wrong
    # project name removes nothing and still reports success.
    DB_PROJECT="${COMPOSE_PROJECT_NAME:-}"
    if [[ -z "$DB_PROJECT" ]]; then
      DB_PROJECT=$(grep -E "^BRAND_SLUG=" "$CONSUMER_DIR/.env" | head -1 | cut -d= -f2- | tr -d "\"'")
    fi
    if [[ -z "$DB_PROJECT" ]]; then
      echo "ERROR: no BRAND_SLUG in .env and no COMPOSE_PROJECT_NAME."
      echo "       Cannot name the ledger-db/dh-db volumes; refusing to"
      echo "       half-reset the world. Set one and re-run."
      exit 1
    fi
    for vol in ledger-db dh-db; do
      docker volume rm "${DB_PROJECT}_${vol}" > /dev/null 2>&1 \
        && echo "  removed volume ${DB_PROJECT}_${vol}" || true
    done
    rm -rf "$CONSUMER_DIR/data/world" \
      "$CONSUMER_DIR/data/unmined-web/maps" \
      "$CONSUMER_DIR/data/unmined-web/index.html" \
      "$CONSUMER_DIR/data/unmined-web/manifest.json" \
      "$CONSUMER_DIR/data/dynamic-data-pack-cache" \
      "$CONSUMER_DIR/data/config/chunky/tasks" \
      "$CONSUMER_DIR/data/config/custom-dimensions"
    rm -f "$CONSUMER_DIR/data/.chunky-complete" "$CONSUMER_DIR/data/.chunky-nether-complete" \
      "$CONSUMER_DIR/data/.chunky-end-complete" "$CONSUMER_DIR/data/.chunky-paradise-lost-complete" \
      "$CONSUMER_DIR/data/.skip-pause" \
      "$CONSUMER_DIR/data/config/portal_links.json" \
      "$CONSUMER_DIR/data/config/custom-dimensions-fingerprints.json"
    LEFT=$(ls -d "$CONSUMER_DIR/data/world" "$CONSUMER_DIR/data/unmined-web/maps" \
      "$CONSUMER_DIR/data/unmined-web/manifest.json" "$CONSUMER_DIR/data/dynamic-data-pack-cache" \
      2> /dev/null || true)
    if [[ -n "$LEFT" ]]; then
      echo "ERROR: paths survived deletion:"
      echo "$LEFT"
      exit 1
    fi
    for vol in ledger-db dh-db; do
      if docker volume inspect "${DB_PROJECT}_${vol}" > /dev/null 2>&1; then
        echo "ERROR: volume ${DB_PROJECT}_${vol} survived deletion"
        exit 1
      fi
    done
    echo "Local world reset. Run ./dev up to generate fresh (set SEED in .env first if changing it)."
    ;;
  unlink)
    if [[ "$(readlink "$CONSUMER_DIR/.stack/current" 2> /dev/null)" != "dev" ]]; then
      echo "Not linked ($(readlink "$CONSUMER_DIR/.stack/current" 2> /dev/null || echo 'no stack')) — nothing to do."
      exit 0
    fi
    NEWEST=$(ls -d "$CONSUMER_DIR"/.stack/v*/ 2> /dev/null \
      | sed 's|.*/\(v[0-9.]*\)/|\1|' \
      | sed 's/^v//' \
      | sort -t. -k1,1nr -k2,2nr -k3,3nr \
      | head -1)
    if [[ -z "$NEWEST" ]]; then
      echo "ERROR: no pulled release bundles in .stack/ — run ./dev pull first."
      exit 1
    fi
    ln -sfn "v$NEWEST" "$CONSUMER_DIR/.stack/current"
    echo "Restored .stack/current -> v$NEWEST. Run ./dev up to return to the release bundle's jars and configs."
    ;;
  down)
    ensure_stack
    ensure_docker
    export CONSUMER_DIR
    exec bash "$CONSUMER_DIR/$STACK_SCRIPTS/dev-up.sh" down
    ;;
  logs)
    ensure_stack
    export CONSUMER_DIR
    exec bash "$CONSUMER_DIR/$STACK_SCRIPTS/dev-up.sh" logs
    ;;
  rcon)
    ensure_stack
