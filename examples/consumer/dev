      echo "  key <name>...         Press keys: esc t e f3 enter tab space up down left right"
      echo "  hold <char> <secs>    Hold one key, e.g. 'hold w 3' to walk forward"
      echo "  type <text>           Type a string into whatever is open"
      echo "  chat <text>           Open chat, type, send — runs AS the player, not console"
      echo "  move|click|dblclick|rightclick <x> <y>"
      echo "                        Screen coords. rightclick is USE — igniting a portal,"
      echo "                        placing a block. Aim with RCON tp <x> <y> <z> <yaw> <pitch>"
      echo "                        first; the crosshair is fixed and the pointer only picks"
      echo "                        the window."
      echo ""
      echo "Aim with RCON instead: tp <player> <x> <y> <z> <yaw> <pitch>"
      exit 1
    fi
    IN_INST="$(resolve_client_instance || true)"
    IN_ID=""
    [[ -n "$IN_INST" ]] && IN_ID="$(basename "$(dirname "$IN_INST")")"
    IN_PID=""
    [[ -n "$IN_ID" ]] && IN_PID="$(prism_client_pid "$IN_ID")"
    if [[ -z "$IN_PID" ]]; then
      # Refusing is the whole safety story. Without a client to aim at, every
      # keystroke below lands in whatever the human happens to have open.
      echo "No running client for '${IN_ID:-${BRAND_SLUG:-this pack}}' — refusing to send input." >&2
      echo "Start one with ./dev launch." >&2
      exit 1
    fi
    osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $IN_PID) to true" >/dev/null 2>&1
    # Focus is asynchronous; without the settle the first event goes to the
    # window that was in front a moment ago.
    /bin/sleep 0.5
    IN_FRONT="$(osascript -e 'tell application "System Events" to get unix id of first process whose frontmost is true' 2>/dev/null || true)"
    if [[ "$IN_FRONT" != "$IN_PID" ]]; then
      echo "Could not bring the client to the front (frontmost pid ${IN_FRONT:-unknown}, wanted $IN_PID)." >&2
      echo "Grant this terminal Accessibility in System Settings > Privacy & Security." >&2
      exit 1
    fi
    case "$IN_ACTION" in
      focus)
        echo "Client focused (pid $IN_PID)."
        ;;
      key)
        [[ $# -gt 0 ]] || { echo "Usage: ./dev input key <name>..." >&2; exit 1; }
        for k in "$@"; do
          case "$k" in
            esc|escape) IN_CODE=53 ;;
            enter|return) IN_CODE=36 ;;
            tab) IN_CODE=48 ;;
            space) IN_CODE=49 ;;
            up) IN_CODE=126 ;;
            down) IN_CODE=125 ;;
            left) IN_CODE=123 ;;
            right) IN_CODE=124 ;;
            f1) IN_CODE=122 ;;
            f2) IN_CODE=120 ;;
            f3) IN_CODE=99 ;;
            f5) IN_CODE=96 ;;
            f11) IN_CODE=103 ;;
            *) IN_CODE="" ;;
          esac
          if [[ -n "$IN_CODE" ]]; then
            osascript -e "tell application \"System Events\" to key code $IN_CODE"
          else
            osascript -e "tell application \"System Events\" to keystroke \"$k\""
          fi
          /bin/sleep 0.1
        done
        echo "Sent: $*"
        ;;
      hold)
        IN_KEY="${1:-}"
        IN_SECS="${2:-1}"
        [[ -n "$IN_KEY" ]] || { echo "Usage: ./dev input hold <char> <secs>" >&2; exit 1; }
        # key down / key up rather than a repeated keystroke: the game reads
        # held state, and a press-release pair moves nothing.
        osascript -e "tell application \"System Events\" to key down \"$IN_KEY\""
        /bin/sleep "$IN_SECS"
        osascript -e "tell application \"System Events\" to key up \"$IN_KEY\""
        echo "Held '$IN_KEY' for ${IN_SECS}s."
        ;;
      type)
        [[ $# -gt 0 ]] || { echo "Usage: ./dev input type <text>" >&2; exit 1; }
        IN_TEXT="$*"
        osascript -e "tell application \"System Events\" to keystroke \"${IN_TEXT//\"/\\\"}\""
        echo "Typed: $IN_TEXT"
        ;;
      chat)
        [[ $# -gt 0 ]] || { echo "Usage: ./dev input chat <text>" >&2; exit 1; }
        IN_TEXT="$*"
        osascript -e 'tell application "System Events" to keystroke "t"'
        /bin/sleep 0.4
        osascript -e "tell application \"System Events\" to keystroke \"${IN_TEXT//\"/\\\"}\""
        /bin/sleep 0.2
        osascript -e 'tell application "System Events" to key code 36'
        echo "Sent as the player: $IN_TEXT"
        ;;
      click|dblclick|move|rightclick)
        [[ $# -ge 2 ]] || { echo "Usage: ./dev input $IN_ACTION <x> <y>" >&2; exit 1; }
        IN_MOUSE="$(ensure_mouse_helper)" || exit 1
        "$IN_MOUSE" "$IN_ACTION" "$1" "$2"
        echo "${IN_ACTION} at $1,$2."
        ;;
      *)
        echo "Unknown action '$IN_ACTION'. Run ./dev input for the list." >&2
        exit 1
        ;;
    esac
    ;;
  reload)
    # Rebuild the linked checkout's in-house mods and re-stage them, so the
    # next ./dev up and ./dev pack carry the current jars. Only meaningful
    # under ./dev link; a release bundle has nothing to rebuild.
    ensure_env
    if [[ "$(readlink "$CONSUMER_DIR/.stack/current" 2> /dev/null)" != "dev" ]]; then
      echo "Not linked to a platform checkout — nothing to rebuild."
      echo "Run ./dev link first, or ./dev update to refresh a release bundle."
      exit 1
    fi
    PLATFORM_FILE="$CONSUMER_DIR/.stack/dev/stack/PLATFORM"
    if [[ ! -f "$PLATFORM_FILE" ]]; then
      echo "Link farm has no PLATFORM marker — re-run ./dev link." >&2
      exit 1
    fi
    PLATFORM="$(cat "$PLATFORM_FILE")"
    echo "Rebuilding in-house mods in $PLATFORM ..."
    for g in "$PLATFORM"/mods/*/gradlew; do
      [[ -x "$g" ]] || continue
      MOD_DIR="$(dirname "$g")"
      echo "  $(basename "$MOD_DIR")"
      (cd "$MOD_DIR" && mise exec -- ./gradlew build -q) || {
        echo "  BUILD FAILED in $MOD_DIR" >&2
        exit 1
      }
    done
    echo "Re-linking so the farm points at the new jars ..."
    bash "$CONSUMER_DIR/dev" link "$PLATFORM" > /dev/null

    # An imported Prism instance never re-reads the .mrpack, and packwiz
    # cannot reach the local pack host, so a rebuilt client jar reaches it
    # only by being copied in. Without this the next launch tests stale code.
    set -a
    # shellcheck disable=SC1091
    source "$CONSUMER_DIR/.env"
    set +a
    INST_DIR="$(resolve_client_instance || true)"
    if [[ -n "$INST_DIR" && -d "$INST_DIR/mods" ]]; then
      COPIED=0
      for j in "$PLATFORM"/mods/*/build/libs/*.jar; do
        [[ -f "$j" ]] || continue
        case "$j" in *-dev.jar | *-sources.jar) continue ;; esac
        if unzip -p "$j" fabric.mod.json 2> /dev/null |
          tr -d ' \n' | grep '"environment":"client"' > /dev/null; then
          # Drop older builds of the same mod or the loader sees duplicates.
          MOD_ID="$(unzip -p "$j" fabric.mod.json 2> /dev/null |
            tr -d ' \n' | sed -n 's/.*"id":"\([a-z0-9_-]*\)".*/\1/p' | head -1)"
          if [[ -n "$MOD_ID" ]]; then
            find "$INST_DIR/mods" -maxdepth 1 -name "${MOD_ID}*.jar" -delete 2> /dev/null || true
          fi
          cp -f "$j" "$INST_DIR/mods/"
          COPIED=$((COPIED + 1))
        fi
      done
      echo "  client-mods: copied $COPIED jar(s) into $(basename "$(dirname "$INST_DIR")")"
    else
      echo "  no Prism instance found — client jar not refreshed"
    fi
    echo "Done. ./dev up installs the server jar; ./dev launch starts the client."
    ;;
  doctor)
    ensure_docker
    if [[ -f "$CONSUMER_DIR/.env" ]]; then
      set -a; source "$CONSUMER_DIR/.env"; set +a
    fi
    BRAND_SLUG="${BRAND_SLUG:-myserver}"
    PREFIX="${COMPOSE_PROJECT_NAME:-$BRAND_SLUG}"
    PASS=0; WARN=0; FAIL=0
    res() {
      case "$1" in
        OK)   echo "  ✓ $2"; PASS=$((PASS + 1)) ;;
        WARN) echo "  ! $2"; WARN=$((WARN + 1)) ;;
        FAIL) echo "  ✗ $2"; FAIL=$((FAIL + 1)) ;;
        *)    echo "  · $2" ;;
      esac
    }
    echo ""
    echo "Local doctor — ${PREFIX}"
    echo "=============================================="
    for c in mc defaults-seed uptime-kuma nav-proxy pack-web mod-checker discord-sync; do
      name="${PREFIX}-${c}-1"
      # try both naming conventions
      STATE=$(docker inspect "$name" --format '{{.State.Status}}' 2>/dev/null \
        || docker inspect "${c}" --format '{{.State.Status}}' 2>/dev/null \
        || echo missing)
      RESTARTS=$(docker inspect "$name" --format '{{.RestartCount}}' 2>/dev/null \
        || docker inspect "${c}" --format '{{.RestartCount}}' 2>/dev/null \
        || echo 0)
      if [[ "$STATE" == "missing" ]]; then
        if [[ "$c" == "defaults-seed" ]]; then
          EXIT=$(docker inspect "$name" --format '{{.State.ExitCode}}' 2>/dev/null \
            || docker inspect "${c}" --format '{{.State.ExitCode}}' 2>/dev/null \
            || echo "?")
          if [[ "$EXIT" == "0" ]]; then
            res OK "defaults-seed exited 0 (normal — runs once)"
          else
            res FAIL "defaults-seed exit code: $EXIT"
          fi
        else
          res WARN "container $c not found"
        fi
      elif [[ "$STATE" == "exited" && "$c" == "defaults-seed" ]]; then
        EXIT=$(docker inspect "$name" --format '{{.State.ExitCode}}' 2>/dev/null \
          || docker inspect "${c}" --format '{{.State.ExitCode}}' 2>/dev/null \
          || echo "?")
        if [[ "$EXIT" == "0" ]]; then
          res OK "defaults-seed exited 0 (normal — runs once)"
        else
          res FAIL "defaults-seed exit code: $EXIT"
        fi
      elif [[ "$STATE" != "running" ]]; then
        res FAIL "container $c is $STATE"
      elif [[ "$RESTARTS" -gt 0 ]]; then
        res WARN "container $c running but restarted ${RESTARTS}x"
      else
        res OK "container $c running"
      fi
    done
    # mc healthcheck
    MC_NAME="${PREFIX}-mc-1"
    MC_HEALTH=$(docker inspect "$MC_NAME" --format '{{.State.Health.Status}}' 2>/dev/null \
      || docker inspect mc --format '{{.State.Health.Status}}' 2>/dev/null \
      || echo unknown)
    if [[ "$MC_HEALTH" == "healthy" ]]; then
      res OK "mc healthcheck: healthy"
    elif [[ "$MC_HEALTH" == "starting" ]]; then
      res INFO "mc healthcheck: starting (still booting)"
    else
      res FAIL "mc healthcheck: $MC_HEALTH"
    fi
    # RCON
    LIST=$(timeout 8 docker exec "$MC_NAME" rcon-cli list 2>/dev/null \
      || timeout 8 docker exec mc rcon-cli list 2>/dev/null || true)
    if [[ -n "$LIST" ]]; then
      res OK "RCON: $LIST"
    else
      res INFO "RCON silent (autopaused or still booting)"
    fi
    echo ""
    echo "=============================================="
    echo "Results: ${PASS} ok, ${WARN} warnings, ${FAIL} failures"
    [[ $FAIL -gt 0 ]] && exit 1
    exit 0
    ;;
  start | stop | restart | status)
    ensure_stack
    ensure_docker
    export CONSUMER_DIR SERVICE_LOCAL=1
    exec bash "$CONSUMER_DIR/$STACK_SCRIPTS/service.sh" "$CMD" "$@"
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    echo "Unknown command: $CMD"
    usage
    exit 1
    ;;
esac
