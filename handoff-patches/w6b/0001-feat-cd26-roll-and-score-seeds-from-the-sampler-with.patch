+        List<String> names = new ArrayList<>(target.spec().wants().keySet());
+        names.addAll(target.spec().shuns());
+        for (String name : names) {
+            List<String> ids = resolve(registry, name);
+            if (ids != null) targets.put(name, ids);
+        }
