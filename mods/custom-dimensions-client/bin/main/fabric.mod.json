{
  "schemaVersion": 1,
  "id": "customdimensionsclient",
  "version": "${version}",
  "name": "Custom Dimensions Companion",
  "description": "Client companion for Custom Dimensions: renders the dimension on the other side of a portal as a live opening rather than a surface.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.customdimensions.client.CustomDimensionsClient"
    ]
  },
  "mixins": [
    "customdimensionsclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=1.21 <=1.21.1",
    "java": ">=21"
  }
}
