{
  "schemaVersion": 1,
  "id": "customdimensions",
  "version": "${version}",
  "name": "Custom Dimensions",
  "description": "Create and manage custom dimensions with portals",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "preLaunch": [
      "com.customdimensions.C2meConfigPatch"
    ],
    "server": [
      "com.customdimensions.MultiverseServer"
    ]
  },
  "mixins": [
    "customdimensions.mixins.json",
    "customdimensions.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=1.21 <=1.21.1",
    "java": ">=21"
  }
}
